<odoo>
    <template id="report_student_transcript_template">
        <t t-call="web.html_container">
            <t t-foreach="report_data" t-as="data">
                <t t-call="academy_lab.report_student_transcript_content">
                </t>
            </t>
        </t>

    </template>


    <template id="report_student_transcript_content">
        <t t-call="web.external_layout">
            <div class="page">
                <!-- Report Header -->
                <div class="text-center mb-4">
                    <h1>Student Transcript Report</h1>
                    <p class="text-muted"> Generated on: <span t-out="report_date"
                            t-options='{"widget": "datetime"}' />
                    </p>
                </div>

                <!-- student Info -->
                <div class="row mb-4">
                    <div class="col-12">
                        <h2>
                            <strong>Name: </strong>
                            <span t-esc="data['student'].name" />
                        </h2>
                        <p>
                            <strong>Student ID: </strong>
                            <span t-out="data['student'].id" />

                        </p>
                        <p>
                            <t t-if="data['student'].email">
                                <strong>Email: </strong>
                                <span t-esc="data['student'].email" />
                            </t>

                            <t t-if="data['student'].phone">
                                <span> | </span>
                                <strong>Phone: </strong>
                                <span t-esc="data['student'].phone" />
                            </t>
                        </p>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-4">
                        <div class="card">
                            <div class="card-body text-center">
                                <h3 class="text-primary" t-out="data['total_courses']" />
                                <p>Total Courses</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="card">
                            <div class="card-body text-center">
                                <p>Top Courses</p>
                                <t t-foreach="data['top_courses']" t-as='course'>
                                    <h5>
                                        <span t-esc="course.course_id.name" /> (<span
                                            t-esc="(course.grade or 0)" />) </h5>
                                </t>
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="card">
                            <div class="card-body text-center">
                                <h3 class="text-info">
                                    <span t-out="data['avg_grade']" />
                                </h3>
                                <p>Average Grade</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div>
                    <h2>Student Enrollments </h2>

                    <table class="table table-bordered" style="width: 100%">
                        <thead>
                            <th style="text-align:center; font-weight:bold;">Course Name</th>
                            <th style="text-align:center; font-weight:bold;">Course code</th>
                            <th style="text-align:center; font-weight:bold;">Grade</th>
                            <th style="text-align:center; font-weight:bold;">Attendance</th>
                            <th style="text-align:center; font-weight:bold;">Status</th>
                            <th style="text-align:center; font-weight:bold;">Enrollment Date</th>
                        </thead>

                        <tbody>
                            <t t-foreach="data['enrollments']" t-as='enroll'>
                                <tr>
                                    <td>
                                        <span t-field="enroll.course_id" />
                                    </td>
                                    <td>
                                        <span t-field="enroll.course_code" />
                                    </td>
                                    <td>
                                        <span t-field="enroll.grade" />
                                    </td>
                                    <td>
                                        <span t-field="enroll.attendance_percentage" />
                                    </td>
                                    <td>
                                        <span t-if="enroll.passed">Passed</span>
                                        <span t-else="">Failed</span>
                                    </td>
                                    <td>
                                        <span t-field="enroll.enrollment_date" />
                                    </td>

                                </tr>
                            </t>
                        </tbody>

                    </table>


                </div>
            </div>
        </t>
    </template>
</odoo>
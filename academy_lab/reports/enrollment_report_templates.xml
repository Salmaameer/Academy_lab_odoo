<odoo>
    <!-- Content: Student name, course name, grade, date, instructor-->
    <template id="course_certificate_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="rec">
                    <div class="page">
                        <h1 style="text-align: center; margin-bottom: 30px;">
                            Course Certificate</h1>

                        <br/>
                        <table class="table table-bordered" style="width: 100%">
                            
                            <tr>
                                <th style="text-align:center; font-weight:bold;">Student Name</th>
                                <td >
                                    <span t-field="rec.student_id"/>
                                </td>
                            </tr>
                            <tr>
                                <th style="text-align:center; font-weight:bold;">Course Name</th>
                                <td>
                                    <span t-field="rec.course_id"/>
                                </td>

                            </tr>
                            <tr>
                                <th style="text-align:center; font-weight:bold;">Grade</th>
                                <td>
                                    <strong t-esc="rec.grade"/>
                                </td>

                            </tr>
                             <tr>
                                <th style="text-align:center; font-weight:bold;">Date</th>
                                <td>
                                    <span t-esc="rec.enrollment_date"/>
                                </td>
                            </tr>
                            <tr>
                                <th style="text-align:center; font-weight:bold;">Instructor</th>
                                <td>
                                    <span t-field="rec.course_id.instructor_name"/>
                                </td>

                            </tr>

                        </table>
                    </div>
                </t>

            </t>

        </t>

    </template>
</odoo>
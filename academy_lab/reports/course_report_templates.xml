                        width: 100%;
                        border: 1px solid #b3adad;
                        border-collapse: collapse;
                        padding: 5px;
                        page-break-inside: unset;
                        }
                        th {
                        border: 1px solid #b3adad;
                        text-align:center;
                        padding: 5px;
                        background: #f0f0f0;
                        color: #313030;
                        }
                        td {
                        border: 1px solid #b3adad;
                        text-align: center;
                        padding: 5px;

                        page-break-after: auto !important; }

                    </style> -->
                    <table class="table">
                        <thead>
                            <th colspan="4" style="text-align: center">General Info</th>
                        </thead>
                        <tbody>
                            <td>Name</td>
                            <td><t t-esc="rec.name"/></td>

                            <td>Code</td>
                            <td><t t-esc="rec.code"/></td>
                        </tbody>

                        <thead>
                            <th colspan="4" style="text-align: center">Addtional Information</th>
                        </thead>
                        <tbody>
                            <td>Category</td>
                            <td><span t-field="rec.category_id"/></td> <!-- with span and t-field it shows the field same as list or form view -->

                            <td>Instructor</td>
                            <td><t t-esc="rec.instructor_id.name"/></td>
                        </tbody>
                    </table>
                    <br/>
                    <table class="table">
                        <thead>
                            <th>Student Name</th>
                            <th>Grade</th>
                            <th>Attendance%</th>
                            <th>Status</th>
                            <th>Enrollment Date</th>
                        </thead>
                        <tbody>
                            <t t-foreach="rec.enrollment_ids" t-as="enroll">
                                <tr>
                                    <td>
                                        <t t-esc="enroll.student_id.name"/>
                                    </td>
                                    <td>
                                        <strong t-field="enroll.grade"/>
                                    </td>
                                    <td>
                                        <span t-field="enroll.attendance_percentage"/>
                                    </td>
                                    <td>
                                        
                                        <span t-if="enroll.passed">Passed</span>
                                        <span t-else="">Failed</span>

                                    </td>
                                    <td>
                                        <span t-field="enroll.enrollment_date"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </t>
        </t>
    </template>
</odoo>
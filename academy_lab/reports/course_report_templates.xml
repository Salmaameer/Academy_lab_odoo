<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <template id="course_report_template">
        <t t-call="web.html_container"> <!-- called in each template-->
            <t t-call="web.external_layout"> <!-- handels adding headers and footer-->
                <t t-foreach="docs" t-as="rec">
                    <!-- could write any html-->
                    <h1>Course report</h1>
                    <!-- <style>
                        /* table, th, td needs to be added as inline style for pdf report */

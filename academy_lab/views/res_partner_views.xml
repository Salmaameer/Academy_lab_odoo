<odoo>

    <record id="view_res_partner_form_academy" model="ir.ui.view">
        <field name="name">res.partner.form.academy</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">

            <xpath expr="//div[contains(@class,'oe_button_box')]" position="inside">
                <button type="action" name="%(academy_lab.action_academy_all_enrollment)d"
                    class="oe_stat_button" icon="fa-book">
                    <field name="total_courses_enrolled"
                        widget="statinfo"
                        string="Enrolled Courses" />
                </button>

                <button type="action" name="%(academy_lab.action_academy_courses)d"
                    class="oe_stat_button" icon="fa-graduation-cap">
                    <field name="total_courses_teaching"
                        widget="statinfo"
                        string="Teaching Courses" />
                </button>
            </xpath>

            <!-- Academy Notebook Page -->
            <xpath expr="//notebook" position="inside">
                <page string="Academy">
                    <group>
                        <field name="is_student" />
                        <field name="is_instructor" />
                        <button string='Print Transcript' 
                                name='academy_lab.student_transcript_report_action'
                                type='action'
                                class='btn-primary'/>
                    </group>
                    <notebook>
                    <page string="Student Enrollments">
                        <field name="student_enrollment_ids">
                            <list>
                                <field name="course_id" />
                                <field name="state" />
                                <field name="grade" />
                                <field name="attendance_percentage" />
                            </list>
                        </field>
                    </page>

                    <page string="Courses Teaching">
                        <field name="instructor_course_ids">
                            <list>
                                <field name="name" />
                                <field name="code" />
                                <field name="state" />
                                <field name="available_seats" />
                            </list>
                        </field>
                    </page>
                   </notebook>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
<odoo>
    <record id="print_filltered_enrollment_form" model="ir.ui.view">
        <field name="name">print.filltered.enrollment.form</field>
        <field name="model">academy.print.wizard</field>
        <field name="arch" type="xml">
            <form>
            <group>
                <field name="from_date"/>
                <field name="to_date"/>
                <field name="student_name"/>
            </group>

            <footer>
                <!-- <button string="Print" type="action" name="" class="btn-primary"/> -->
                <button string="Filter" type="object" name="action_apply_filter" class="btn-primary"/>
                <button string='Cancel' special='cancel' class='btn-secondary'/>
            </footer>
            </form>
        </field>

    </record>

    <record id="print_filltered_enrollment_action" model="ir.actions.act_window">
        <field name="name">Filter Enrollments and print</field>
        <field name="res_model">academy.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>
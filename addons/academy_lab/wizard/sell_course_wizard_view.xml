<odoo>
    <record id='sell_course_wizard_form' model='ir.ui.view'>
        <field name='name'>sell.course.wizard.from</field>
        <field name='model'>academy.product.wizard</field>
        <field name='arch' type='xml'>
            <form>
            <group>
                <field name='name' readonly="1"/>
                <field name='price'/>
            </group>

            <footer>
            <button string='Create' type='object' name='action_create' class='btn-primary'/>    
            <button string='Cancel' special='cancel' class='btn-secondary'/>
            </footer>
            </form>
        </field>
    </record>

    <record id='sell_course_wizard_action' model='ir.actions.act_window'>
        <field name='name'>Generate Product</field>
        <field name='res_model'>academy.product.wizard</field>
        <field name='target'>new</field>
        <field name="view_mode">form</field>
    </record>



</odoo>